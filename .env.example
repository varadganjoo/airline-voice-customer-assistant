GEMINI_API_KEY=your_key_here
APP_ENV=development
GEMINI_LIVE_MODEL=gemini-3.8-live
PORT=3000
# Optional remote libSQL database; leave blank for local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Shared daily cap on issued voice tokens (including reconnections).
DEMO_DAILY_TOKEN_LIMIT=100
# Optional canonical origin, without trailing slash.
APP_ORIGIN=
# Set a random UUIDv4 for shared HTTPS deployments: /?k=<ACCESS_KEY>.
ACCESS_KEY=
# Separate operator password (32+ random characters). Username: operator.
# Leave blank to disable all /ops pages and /api/ops endpoints.
OPS_ACCESS_KEY=
# Emergency write pause; only "true" permits new booking commits.
BOOKING_WRITES_ENABLED=true
# Approval judges (consent.py). Different models so the second check is independent; measured with scripts/eval_consent.py.
CONSENT_MODEL=gemini-3.6-flash
CONSENT_VERIFIER_MODEL=gemini-3.5-flash
